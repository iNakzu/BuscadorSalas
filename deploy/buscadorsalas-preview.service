[Unit]
Description=Buscador de Salas UDP - Preview V1
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/BuscadorSalas-v1
Environment="PATH=/home/ubuntu/BuscadorSalas/venv/bin:/usr/local/bin:/usr/bin"
EnvironmentFile=-/home/ubuntu/BuscadorSalas-v1/.env
Environment="SCHEDULE_CACHE_FILE=/var/lib/buscadorsalas-preview/data.json"
Environment="PUBLIC_ORIGIN=https://v1.144-22-33-41.sslip.io"
ExecStart=/home/ubuntu/BuscadorSalas/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:5001 flask_app:app --timeout 60
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
